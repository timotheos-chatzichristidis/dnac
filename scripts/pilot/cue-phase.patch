 /* After a base symbol s is known: append it, follow/break every match, and    */
 /* refresh the hash anchors (newhist already includes s).                       */
+/* PHASE PATCH (scratch only, docs/cue-phase-oracle-prediction.md).
+   DNAC_PHASE unset: release choice. =back: furthest back-agreement (everywhere).
+   =oracle-enc: best agreement with the next 30 bases, read from DNAC_PHASE_SEQ (the
+   whole history as 0..3 bytes), choices written to DNAC_PHASE_SIDE. =oracle-dec:
+   choices replayed from DNAC_PHASE_SIDE. Oracle modes touch target loads only. */
+static int g_ph = -1; static uint8_t *g_fut = NULL; static size_t g_futn = 0; static FILE *g_side = NULL;
+static void ph_close(void) { if (g_side) fclose(g_side); }
+static int ph_pick(const int64_t *cq, int nc, uint32_t np) {
+    if (g_ph < 0) {
+        const char *m = getenv("DNAC_PHASE"); g_ph = 0;
+        if (m && !strcmp(m, "back")) g_ph = 1;
+        else if (m && (!strcmp(m, "oracle-enc") || !strcmp(m, "oracle-dec"))) {
+            g_ph = m[7] == 'e' ? 2 : 3;
+            const char *sp = getenv("DNAC_PHASE_SIDE");
+            g_side = sp ? fopen(sp, g_ph == 2 ? "wb" : "rb") : NULL;
+            if (!g_side) { fprintf(stderr, "phase: no side file\n"); exit(2); }
+            atexit(ph_close);
+            if (g_ph == 2) {
+                FILE *f = fopen(getenv("DNAC_PHASE_SEQ"), "rb");
+                if (!f) { fprintf(stderr, "phase: no seq file\n"); exit(2); }
+                dnac_fseek64(f, 0, SEEK_END); g_futn = (size_t)dnac_ftell64(f); dnac_fseek64(f, 0, SEEK_SET);
+                g_fut = malloc(g_futn);
+                if (fread(g_fut, 1, g_futn, f) != g_futn) { fprintf(stderr, "phase: short seq\n"); exit(2); }
+                fclose(f);
+            }
+        }
+    }
+    if (g_ph == 0) return 0;
+    if (g_ph == 1) {
+        int best = 0, bl = -1;
+        for (int i = 0; i < nc; i++) { int l = back_agree((uint32_t)(cq[i] - 1), np, 32); if (l > bl) { bl = l; best = i; } }
+        return best;
+    }
+    if (g_refbase == 0 || np < g_refbase) return 0;
+    if (g_ph == 3) { int c = fgetc(g_side); if (c == EOF) { fprintf(stderr, "phase: side file ended\n"); exit(2); } return c; }
+    if (g_seq[np] != g_fut[np]) { fprintf(stderr, "phase: history misaligned at %u\n", np); exit(2); }
+    int best = 0, bs = -1;
+    for (int i = 0; i < nc; i++) {
+        int sc = 0;
+        for (int j = 0; j < 30; j++) {
+            size_t a = (size_t)np + 1 + j, b = (size_t)cq[i] + j;
+            if (a < g_futn && b < g_futn && g_fut[a] == g_fut[b]) sc++;
+        }
+        if (sc > bs) { bs = sc; best = i; }
+    }
+    fputc(best, g_side);
+    return best;
+}
+
