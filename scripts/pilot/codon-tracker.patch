+/* CODON ORACLE (scratch only, docs/codon-oracle-prediction.md). DNAC_CODON = a label
+   per history base (0-2 + gene codon position, 3-5 - gene, 6 non-coding), DNAC_CODON_SEQ
+   = the same history as 0..3 bytes, asserted base by base. Unset: nothing changes. */
+static int g_cl_on = -1; static uint8_t *g_cl = NULL, *g_clseq = NULL; static size_t g_cln = 0;
+static uint8_t *cl_read(const char *path, size_t *n) {
+    FILE *f = path ? fopen(path, "rb") : NULL;
+    if (!f) { fprintf(stderr, "codon: cannot open %s\n", path ? path : "(null)"); exit(2); }
+    dnac_fseek64(f, 0, SEEK_END); *n = (size_t)dnac_ftell64(f); dnac_fseek64(f, 0, SEEK_SET);
+    uint8_t *b = malloc(*n);
+    if (!b || fread(b, 1, *n, f) != *n) { fprintf(stderr, "codon: short read\n"); exit(2); }
+    fclose(f); return b;
+}
+/* CODON TRACKER (docs/codon-tracker-prediction.md): DNAC_CODON=track. Seven fixed
+   hypotheses (+ strand offset 0..2, - strand offset 0..2, non-coding); a shared
+   P(base | 5 previous bases, label) table; decayed log-loss scores; hysteresis. */
+#define TRK_ORD 5
+#define TRK_DECAY (1.0 - 1.0 / 128.0)
+#define TRK_MARGIN 4.0
+static uint16_t *g_tk_tab = NULL; static double g_tk_sc[7]; static int g_tk_cur = 0;
+static uint8_t *g_tk_hist = NULL; static size_t g_tk_cap = 0, g_tk_n = 0;
+static int trk_label(int h, size_t t) {
+    if (h < 3) return (int)((t + (size_t)h) % 3);
+    if (h < 6) return 3 + (int)(((size_t)(h - 3) + 3 - t % 3) % 3);
+    return 6;
+}
+static void trk_dump(void) {
+    const char *p = getenv("DNAC_CODON_LOG");
+    FILE *f = p ? fopen(p, "wb") : NULL;
+    if (f) { fwrite(g_tk_hist, 1, g_tk_n, f); fclose(f); }
+}
+static void trk_update(uint32_t np, int s) {
+    if (np >= g_tk_cap) {
+        g_tk_cap = g_tk_cap ? g_tk_cap * 2 : (1u << 20);
+        g_tk_hist = realloc(g_tk_hist, g_tk_cap);
+        if (!g_tk_hist) { fprintf(stderr, "tracker: out of memory\n"); exit(2); }
+    }
+    int ctx = 0;
+    for (int j = TRK_ORD; j >= 1; j--) ctx = ctx * 4 + (np >= (uint32_t)j ? g_seq[np - j] : 0);
+    int used = trk_label(g_tk_cur, np);
+    g_tk_hist[np] = (uint8_t)used; g_tk_n = (size_t)np + 1;
+    for (int h = 0; h < 7; h++) {
+        uint16_t *c = &g_tk_tab[((size_t)trk_label(h, np) * 1024 + ctx) * 4];
+        double p = (c[s] + 0.5) / (c[0] + c[1] + c[2] + c[3] + 2.0);
+        g_tk_sc[h] = g_tk_sc[h] * TRK_DECAY + log2(p);
+    }
+    uint16_t *c = &g_tk_tab[((size_t)used * 1024 + ctx) * 4];
+    if (++c[s] == 65535) for (int k = 0; k < 4; k++) c[k] >>= 1;
+    int best = 0;
+    for (int h = 1; h < 7; h++) if (g_tk_sc[h] > g_tk_sc[best]) best = h;
+    if (best != g_tk_cur && g_tk_sc[best] > g_tk_sc[g_tk_cur] + TRK_MARGIN) g_tk_cur = best;
+}
+
+static int codon_on(void) {
+    if (g_cl_on < 0) {
+        const char *p = getenv("DNAC_CODON");
+        g_cl_on = 0;
+        if (p && !strcmp(p, "track")) {
+            g_tk_tab = calloc((size_t)7 * 1024 * 4, sizeof(uint16_t));
+            g_cl_on = 2; atexit(trk_dump);
+            fprintf(stderr, "codon: tracker on\n");
+        } else if (p) {
+            size_t n2; g_cl = cl_read(p, &g_cln); g_clseq = cl_read(getenv("DNAC_CODON_SEQ"), &n2);
+            if (n2 != g_cln) { fprintf(stderr, "codon: label/seq length differ\n"); exit(2); }
+            g_cl_on = 1; fprintf(stderr, "codon: %zu labels from %s\n", g_cln, p);
+        }
+    }
+    return g_cl_on;
+}
+static int codon_lab(size_t pos) {
+    if (g_cl_on == 2) return pos < g_tk_n ? g_tk_hist[pos] : trk_label(g_tk_cur, pos);
+    return pos < g_cln ? g_cl[pos] : 6;
+}
+static uint64_t codon_ctx(int i, uint64_t ctx, int lab) {
+    if (g_direct[i]) return ctx | ((uint64_t)lab << (2 * g_order[i]));
+    return ctx ^ ((uint64_t)(lab + 1) << 56);
+}
+static void codon_apply(uint64_t *ctxv) {
