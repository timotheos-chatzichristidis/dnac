# Line endings are normalised to LF inside the repository.
# Shell scripts MUST check out as LF: a CRLF `#!/bin/sh` line makes Linux fail
# with "bad interpreter: No such file or directory".
* text=auto eol=lf

*.sh      text eol=lf
*.c       text eol=lf
*.h       text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.cff     text eol=lf
Makefile  text eol=lf

# PowerShell scripts stay CRLF — they are the Windows half of the toolchain.
*.ps1     text eol=crlf

# Never touched.
*.fa      binary
*.dnac    binary
*.state   binary
