 /* After a base symbol s is known: append it, follow/break every match, and    */
 /* refresh the hash anchors (newhist already includes s).                       */
+/* PILOT-WAVE PROBE (scratch only) */
+static uint64_t pw_n, pw_agree, pw_dis, pw_da, pw_df, pw_both, pw_none, pw_ha[64], pw_hr[64];
+static int pw_pend, pw_pa, pw_pf, pw_reg;
+static void pw_report(void) {
+    double tv = 0; for (int i = 0; i < 64; i++) { double a = pw_n ? (double)pw_ha[i]/pw_n : 0, r = pw_n ? (double)pw_hr[i]/pw_n : 0; tv += fabs(a - r); }
+    fprintf(stderr, "PW n=%llu agree=%.4f dis=%llu anchor_hit=%.4f fresh_hit=%.4f both=%.4f none=%.4f TV=%.4f\n",
+        (unsigned long long)pw_n, pw_n ? (double)pw_agree/pw_n : 0, (unsigned long long)pw_dis,
+        pw_dis ? (double)pw_da/pw_dis : 0, pw_dis ? (double)pw_df/pw_dis : 0,
+        pw_dis ? (double)pw_both/pw_dis : 0, pw_dis ? (double)pw_none/pw_dis : 0, tv / 2);
+    fprintf(stderr, "PW bins(log2 lag): A / R\n");
+    for (int i = 0; i < 64; i++) if (pw_ha[i] || pw_hr[i]) fprintf(stderr, "PW %2d %.4f %.4f\n", i, (double)pw_ha[i]/pw_n, (double)pw_hr[i]/pw_n);
+}
